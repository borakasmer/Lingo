{
    "schemes": [
        "http"
    ],
    "swagger": "2.0",
    "info": {
        "description": "Generic repository ile kullanıcı arama API'si.",
        "title": "SQL ORM API",
        "contact": {},
        "version": "1.0"
    },
    "host": "localhost:8080",
    "basePath": "/",
    "paths": {
        "/api/users": {
            "get": {
                "description": "Adında aranan ifade geçen aktif kullanıcıları listeler.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Users"
                ],
                "summary": "İsme göre kullanıcı ara",
                "parameters": [
                    {
                        "type": "string",
                        "example": "Bora",
                        "description": "Aranacak isim",
                        "name": "name",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/Models.Person"
                            }
                        }
                    },
                    "400": {
                        "description": "name parametresi zorunludur",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "405": {
                        "description": "Method not allowed",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "Kullanıcılar sorgulanamadı",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/api/users/append-x-over-40": {
            "post": {
                "description": "Aktif kullanıcıların yalnızca değişen Name alanını günceller. Bütün gruplar tek transaction içinde çalışır.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Users"
                ],
                "summary": "Yaşı 40'tan büyük kullanıcıların isimlerine X ekle",
                "parameters": [
                    {
                        "minimum": 1,
                        "type": "integer",
                        "default": 1,
                        "description": "Batch boyutu",
                        "name": "batchSize",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/User.BatchUpdateResponse"
                        }
                    },
                    "400": {
                        "description": "Geçersiz batchSize",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "405": {
                        "description": "Method not allowed",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "Güncelleme tamamlanamadı",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/api/users/paging": {
            "get": {
                "description": "Aktif kullanıcıları listeler. sortBy boşsa Id kullanılır.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Users"
                ],
                "summary": "Kullanıcıları sayfalayarak ve sıralayarak getir",
                "parameters": [
                    {
                        "minimum": 1,
                        "type": "integer",
                        "default": 1,
                        "description": "Sayfa numarası",
                        "name": "page",
                        "in": "query"
                    },
                    {
                        "maximum": 100,
                        "minimum": 1,
                        "type": "integer",
                        "default": 10,
                        "description": "Sayfa başına kayıt",
                        "name": "pageSize",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "default": "Id",
                        "description": "Sıralama alanı: Id, Name, Age, Gender",
                        "name": "sortBy",
                        "in": "query"
                    },
                    {
                        "type": "boolean",
                        "default": true,
                        "description": "true: artan, false: azalan",
                        "name": "ascending",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/Models.Person"
                            }
                        }
                    },
                    "400": {
                        "description": "Geçersiz parametre",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "405": {
                        "description": "Method not allowed",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "Kullanıcılar sorgulanamadı",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/api/users/search": {
            "get": {
                "description": "Cinsiyet eşleşmeli **VE** (yaş belirtilen sınırdan büyük olmalı **VEYA** isim aranan ifadeyi içermeli).",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Users"
                ],
                "summary": "AND ve OR koşullarıyla kullanıcı ara",
                "parameters": [
                    {
                        "enum": [
                            "Male",
                            "Female"
                        ],
                        "type": "string",
                        "description": "Cinsiyet",
                        "name": "gender",
                        "in": "query",
                        "required": true
                    },
                    {
                        "minimum": 0,
                        "type": "integer",
                        "example": 30,
                        "description": "Yaş alt sınırı; bu değerden büyük",
                        "name": "age",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "string",
                        "example": "Bor",
                        "description": "İsimde aranacak ifade",
                        "name": "name",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/Models.Person"
                            }
                        }
                    },
                    "400": {
                        "description": "Geçersiz arama parametreleri",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "405": {
                        "description": "Method not allowed",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "Kullanıcılar sorgulanamadı",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "Models.Person": {
            "type": "object",
            "properties": {
                "age": {
                    "type": "integer"
                },
                "gender": {
                    "type": "string"
                },
                "id": {
                    "type": "integer"
                },
                "isDeleted": {
                    "type": "boolean"
                },
                "name": {
                    "type": "string"
                }
            }
        },
        "User.BatchUpdateResponse": {
            "type": "object",
            "properties": {
                "updatedCount": {
                    "type": "integer"
                }
            }
        }
    }
}